   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1",
   "metadata": {},
   "source": [
    "### Prepare metadata"
   ]
  },
  {
   "cell_type": "raw",
   "id": "2",
   "metadata": {},
   "source": [
    "from create_master_metadata import create_master_metadata\n",
    "\n",
    "master_metadata = create_master_metadata(\n",
    "    rnaseq_meta_path='../../metadata.csv',\n",
    "    proteomics_meta_path='../../proteomics/data/proteomics_metadata.csv',\n",
    "    output_path='../data/master_baseline_metadata.csv'\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Checkpoint\n",
    "meta = pd.read_csv('../data/master_baseline_metadata.csv')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4",
   "metadata": {},
   "source": [
    "### Prepare expression data"
   ]
  },
  {
   "cell_type": "raw",
   "id": "5",
   "metadata": {},
   "source": [
    "from align_matrix_columns import load_and_align_matrix\n",
    "\n",
    "# RNA-seq\n",
    "ppmi_rnaseq = load_and_align_matrix(\"../../data/feature_counts_PPMIm0.csv\", \n",
    "                                    meta, \n",
    "                                    'rnaseq_sample_id',\n",
    "                                    output_path = \"../data/ppmi_rnaseq.csv\")\n",
    "pdbp_rnaseq = load_and_align_matrix(\"../../data/feature_counts_PDBPm0.csv\", \n",
    "                                    meta,\n",
    "                                    'rnaseq_sample_id',\n",
    "                                    output_path = '../data/pdbp_rnaseq.csv')\n",
    "\n",
    "# CSF proteomics\n",
    "ppmi_csf_prot = load_and_align_matrix(\"../../proteomics/data/CSF_PDIA_protein_batch_corrected_matrix.csv\", \n",
    "                                      meta.loc[meta['study']==\"PPMI\"], \n",
    "                                      'csf_pro_sample_id',\n",
    "                                      output_path = '../data/ppmi_csf_prot.csv')\n",
    "pdbp_csf_prot = load_and_align_matrix(\"../../proteomics/data/CSF_PDIA_protein_batch_corrected_matrix.csv\", \n",
    "                                      meta.loc[meta['study']==\"PDBP\"], \n",
    "                                      'csf_pro_sample_id',\n",
    "                                      output_path = '../data/pdbp_csf_prot.csv')\n",
    "\n",
    "# Plasma proteomics\n",
    "ppmi_pla_prot = load_and_align_matrix(\"../../proteomics/data/PLA_PDIA_protein_batch_corrected_matrix.csv\", \n",
    "                                      meta.loc[meta['study']==\"PPMI\"], \n",
    "                                      'plasma_pro_sample_id',\n",
    "                                      output_path = '../data/ppmi_pla_prot.csv')\n",
    "pdbp_pla_prot = load_and_align_matrix(\"../../proteomics/data/PLA_PDIA_protein_batch_corrected_matrix.csv\", \n",
    "                                      meta.loc[meta['study']==\"PDBP\"], \n",
    "                                      'plasma_pro_sample_id',\n",
    "                                      output_path = '../data/pdbp_pla_prot.csv')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6",
   "metadata": {},
   "source": [
    "### Preprocess RNAseq data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7",
   "metadata": {},
   "outputs": [],
   "source": [
    "from preprocess_rnaseq import preprocess_rnaseq"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8",
   "metadata": {},
   "outputs": [],
   "source": [
    "log_matrix = preprocess_rnaseq(\n",
    "    counts_file=\"../data/ppmi_rnaseq.csv\",\n",
    "    metadata_file=\"../data/master_baseline_metadata.csv\",\n",
    "    output_file=\"../data/ppmi_rnaseq_log1p_filtered.csv\",\n",
    "    visit_filter=0.0,\n",
    "    cohort_name=\"PPMI\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9",
   "metadata": {},
   "source": [
    "#### QC checks for preprocessing step"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "10",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load your generated log1p matrix\n",
    "log_df = pd.read_csv(\"../data/ppmi_rnaseq_log1p_filtered.csv\", index_col=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "11",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check for NaNs or infinities\n",
    "print(\"Any NaN values?\", log_df.isna().sum().sum())\n",
    "print(\"Any Infinite values?\", np.isinf(log_df.select_dtypes(include=np.number)).sum().sum())\n",
    "print(f\"Matrix shape (Genes x Samples): {log_df.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(log_df.iloc[:5, :5]) # Preview top-left corner\n",
    "print(\"Overall Mean:\", log_df.values.mean())\n",
    "print(\"Overall Std Dev:\", log_df.values.std())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.decomposition import PCA\n",
    "\n",
    "# Transpose so samples are rows for PCA (Samples x Genes)\n",
    "pca_data = log_df.T\n",
    "\n",
    "pca = PCA(n_components=5)\n",
    "pcs = pca.fit_transform(pca_data)\n",
    "explained_var = pca.explained_variance_ratio_ * 100\n",
    "print(f\"PC1 ({explained_var[0]:.1f}%)\", f\"PC2 ({explained_var[1]:.1f}%)\")\n",
    "\n",
    "pca_df = pd.DataFrame(pcs, index=pca_data.index)\n",
    "\n",
    "# Merge with metadata to color-code by technical factors (e.g., plate)\n",
    "m = meta.loc[meta['study']=='PPMI'].set_index('participant_id')[['plate', 'sex', 'diagnosis']]\n",
    "\n",
    "pca_df = pca_df.join(m, how='inner')\n",
    "\n",
    "# Plot PCA colored by sequencing plate\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.scatterplot(data=pca_df, x=pca_df.columns[0], y=pca_df.columns[1], hue='plate', alpha=0.7, palette='tab10', legend=False)\n",
    "plt.title(\"PCA of Log1p Matrix (Pre-Batch Correction, colored by plate)\")\n",
    "plt.xlabel(f\"PC1 ({explained_var[0]:.1f}%)\")\n",
    "plt.ylabel(f\"PC2 ({explained_var[1]:.1f}%)\")\n",
    "#plt.savefig( \"../figures/ppmi_log1p_preBatch_byPlate_PCA1.jpg\", dpi=600,bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
  },
