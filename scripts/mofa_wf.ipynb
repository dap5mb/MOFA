   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "22",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply normalization (log2 + median centering)
csfp_clean = normalize_proteomics(csfp_df, log2_transform=True)
plap_clean = normalize_proteomics(plap_df, log2_transform=True)
   ]
